[{"/Users/roland/repos/powerhypergithubpages/src/index.js":"1","/Users/roland/repos/powerhypergithubpages/src/App.js":"2","/Users/roland/repos/powerhypergithubpages/src/components/Navbar.js":"3","/Users/roland/repos/powerhypergithubpages/src/components/Ambition.js":"4","/Users/roland/repos/powerhypergithubpages/src/components/LiveTracker.js":"5","/Users/roland/repos/powerhypergithubpages/src/components/MachineLearning.js":"6","/Users/roland/repos/powerhypergithubpages/src/components/Footer.js":"7","/Users/roland/repos/powerhypergithubpages/src/components/FundingRenewableEnergy.js":"8","/Users/roland/repos/powerhypergithubpages/src/components/Startups.js":"9","/Users/roland/repos/powerhypergithubpages/src/components/Home.js":"10","/Users/roland/repos/powerhypergithubpages/src/components/CommunityEnergy.js":"11","/Users/roland/repos/powerhypergithubpages/src/components/EnergyMarkets.js":"12","/Users/roland/repos/powerhypergithubpages/src/components/SustainableInvesting.js":"13","/Users/roland/repos/powerhypergithubpages/src/components/EnergyAttributeCertificates.js":"14","/Users/roland/repos/powerhypergithubpages/src/components/CopyrightDisclaimer.js":"15","/Users/roland/repos/powerhypergithubpages/src/components/PowerPurchaseAgreements.js":"16","/Users/roland/repos/powerhypergithubpages/src/components/Timeline/Timeline.js":"17","/Users/roland/repos/powerhypergithubpages/src/components/CircularEconomy.js":"18"},{"size":469,"mtime":1760819790257,"results":"19","hashOfConfig":"20"},{"size":2531,"mtime":1760819790244,"results":"21","hashOfConfig":"20"},{"size":3619,"mtime":1760819790246,"results":"22","hashOfConfig":"20"},{"size":2197,"mtime":1760819790245,"results":"23","hashOfConfig":"20"},{"size":1030,"mtime":1760819790246,"results":"24","hashOfConfig":"20"},{"size":1585,"mtime":1760819790246,"results":"25","hashOfConfig":"20"},{"size":4442,"mtime":1760819790245,"results":"26","hashOfConfig":"20"},{"size":2491,"mtime":1760819790245,"results":"27","hashOfConfig":"20"},