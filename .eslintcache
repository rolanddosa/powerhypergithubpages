earn more: https://github.com/jsx-eslint/eslint-plugin-jsx-a11y/blob/HEAD/docs/rules/anchor-is-valid.md",{"range":"165","text":"162"},"jsx-a11y/alt-text","img elements must have an alt prop, either with meaningful text, or an empty string for decorative images.",{"range":"166","text":"162"},{"range":"167","text":"162"},{"range":"168","text":"162"},{"range":"169","text":"162"},{"range":"170","text":"162"},"react/style-prop-object","Style prop value must be an object","JSXAttribute","stylePropNotObject",{"range":"171","text":"162"},{"range":"172","text":"162"},{"range":"173","text":"162"},{"range":"174","text":"162"},{"range":"175","text":"162"},"'YouTube' is defined but never used.",{"range":"176","text":"162"},{"range":"177","text":"162"},{"range":"178","text":"162"},{"range":"179","text":"162"},[2112,2112]," rel=\"noreferrer\"",[405,405],[869,869],[1940,1940],[2099,2099],[1206,1206],[2319,2319],[1096,1096],[1686,1686],[3572,3572],[4355,4355],[4546,4546],[5795,5795],[677,677],[1801,1801],[534,534],[877,877],[2091,2091]]