2"},{"filePath":"63","messages":"64","errorCount":0,"fatalErrorCount":0,"warningCount":12,"fixableErrorCount":0,"fixableWarningCount":5,"source":"65"},{"filePath":"66","messages":"67","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":1,"source":"68"},{"filePath":"69","messages":"70","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"71"},{"filePath":"72","messages":"73","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":1,"source":"74"},{"filePath":"75","messages":"76","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":1,"source":"77"},{"filePath":"78","messages":"79","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"80","messages":"81","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"82","messages":"83","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":2,"source":"84"},{"filePath":"85","messages":"86","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"/Users/roland/repos/powerhypergithubpages/src/index.js",[],"/Users/roland/repos/powerhypergithubpages/src/App.js",[],"/Users/roland/repos/powerhypergithubpages/src/components/Navbar.js",["87","88","89","90","91"],"import React from \"react\";\nimport {NavLink} from \"react-bootstrap\";\n\nfunction Navbar() {\n    {\n        return (\n            <nav className=\"navbar navbar-expand-lg navbar-light bg-light shadow\">\n                <a className=\"navbar-brand\" href=\"#\">powerhyper</a>\n                <button className=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\"\n                        data-target=\"#navbarSupportedContent\" aria-controls=\"navbarSupportedContent\"\n                        aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n                    <span className=\"navbar-toggler-icon\"></span>\n                </button>\n\n                <div className=\"collapse navbar-collapse\" id=\"navbarSupportedContent\">\n                    <ul className=\"navbar-nav mr-auto\">\n                        <li className=\"nav-item active\">\n                            <a className=\"nav-link\" href=\"/\">Home <span className=\"sr-only\">(current)</span></a>\n                        </li>\n                        <li className=\"nav-item\">\n                            <a className=\"nav-link\" href=\"#/ambition\">Ambition</a>\n                        </li>\n                        <li className=\"nav-item\">\n                            <a className=\"nav-link\" href=\"#/timeline\">Timeline</a>\n                        </li>\n                        <li className=\"nav-item dropdown\">\n                            <a className=\"nav-link dropdown-toggle\" href=\"#\" id=\"navbarDropdown\" role=\"button\"\n                               data-toggle=\"dropdown\" aria-haspopup=\"true\" aria-expanded=\"false\">Energy Economics</a>\n                            <div className=\"dropdown-menu\" aria-labelledby=\"navbarDropdown\">\n                                <a className=\"dropdown-item\" href=\"#/fundingRenewableEnergy\">Funding Renewable Energy</a>\n                                <a className=\"dropdown-item\" href=\"#/powerPurchaseAgreements\">Power Purchase Agreements (PPA)</a>\n                                <a className=\"dropdown-item\" href=\"#/energyMarkets\">Energy Markets</a>\n                                <a className=\"dropdown-item\" href=\"#/carbonMarkets\">Carbon Markets</a>\n                            </div>\n                        </li>\n                        <li className=\"nav-item\">\n                            <a className=\"nav-link\" href=\"#/liveTracker\">Live Tracker</a>\n                        </li>\n                        <li className=\"nav-item dropdown\">\n                            <a className=\"nav-link dropdown-toggle\" href=\"#\" id=\"navbarDropdown\" role=\"button\"\n                               data-toggle=\"dropdown\" aria-haspopup=\"true\" aria-expanded=\"false\">Impactful Ideas</a>\n                            <div className=\"dropdown-menu\" aria-labelledby=\"navbarDropdown\">\n                                <a className=\"dropdown-item\" href=\"#/energyAttributeCertificates\">Energy Attribute\n                                    Certificates</a>\n                                <a className=\"dropdown-item\" href=\"#/machineLearning\">Machine Learning</a>\n                                <a className=\"dropdown-item\" href=\"#/sustainableInvesting\">Sustainable Investing</a>\n                                <a className=\"dropdown-item\" href=\"#/communityEnergy\">Community Energy</a>\n                                <a className=\"dropdown-item\" href=\"#/circularEconomy\">Circular Economy</a>\n                                <a className=\"dropdown-item\" href=\"#/startups\">Startups</a>\n                            </div>\n                        </li>\n                    </ul>\n                </div>\n            </nav>\n        );\n    }\n}\n\nexport default Navbar;","/Users/roland/repos/powerhypergithubpages/src/components/Ambition.js",["92","93"],"import * as React from \"react\";\nimport EUEnergyStats from '../images/EUEnergyStats.jpg';\n\nexport class Ambition extends React.Component {\n    render() {\n        return (\n            <div className=\"my-5 ml-custom mr-custom\">\n                <h3>The Ambition</h3>\n                <br/>\n                <p><i>\"There is nothing in the laws of physics and chemistry to prevent humanity from stopping\n                    global heating getting out of control.\" - Mark Watts, Executive Director of C40 Cities\n                </i></p>\n                <p>Out of control climate change will cause the following:</p>\n                <ul>\n                    <li>Increased sea level and floodings severly affecting low-lying countries and coastal\n                        cities, causing relocation\n                        of people which will lead to conflicts\n                    </li>\n                    <li>Infrastructure damage and food shortages caused by violent weather</li>\n                    <li>Melting snow will alter pattern and timing of flows of rivers that serve people</li>\n                    <li>Desertification in locations such as Southern Europe, Northern Nigeria, Mexico, putting\n                        pressure on people to\n                        relocate\n                    </li>\n                </ul>\n                <p>The cost of 1 litre of bottled water being so close to the cost of 1 litre of petrol fuel,\n                    considering\n                    the tasks behind extracting and processing raw oil, clearly indicates the potential of\n                    providing\n                    renewable energy much cheaper than it currently is and the technological improvements coming\n                    from developing\n                    these sources of energy.</p>\n                <br/>\n                <div className=\"text-center\">\n                    <img src={EUEnergyStats} className=\"imgthumbnail\" height=\"500\"\n                         width=\"800\" alt=\"Responsive image\"/>\n                    <br/>\n                    <a href=\"https://ec.europa.eu/eurostat/\" target=\"_blank\">ⓘ Source: eurostat</a>\n                </div>\n            </div>\n        )\n    }\n}","/Users/roland/repos/powerhypergithubpages/src/components/LiveTracker.js",["94","95"],"import * as React from \"react\";\nimport Iframe from \"react-iframe\";\nimport BuiltByTomorrow from \"../images/built-by-tomorrow.svg\";\n\nexport class LiveTracker extends React.Component {\n\n    render() {\n\n        return (\n            <div className={'mt-5 mb-5'} style={{justifyContent:'center', textAlign:'center'}}>\n                <p>A great tool built by <a href={\"https://www.tmrow.com/\"} target={\"_blank\"}>Tomorrow</a> for real time tracking of power generation globally.</p>\n                <br/>\n                <img src={BuiltByTomorrow} className=\"imgthumbnail align-self-center\"\n                     width=\"200\" alt=\"Responsive image\"/>\n                <br/>\n            <br/>\n                <Iframe url=\"https://www.electricitymap.org/map\"\n                        width=\"450px\"\n                        height=\"450px\"\n                        id=\"myId\"\n                        className=\"myClassname\"\n                        display=\"initial\"\n                        position=\"relative\"/>\n            </div>\n        )\n    }\n}","/Users/roland/repos/powerhypergithubpages/src/components/MachineLearning.js",["96"],"import * as React from \"react\";\nimport pdf from '../resources/climatechangeai_Tackling_Climate_Change_with_Machine_Learning.pdf'\nimport {Viewer} from '@react-pdf-viewer/core';\nimport {pdfjs} from 'react-pdf';\nimport {defaultLayoutPlugin} from \"@react-pdf-viewer/default-layout\";\nimport '@react-pdf-viewer/core/lib/styles/index.css';\nimport '@react-pdf-viewer/default-layout/lib/styles/index.css';\n\npdfjs.GlobalWorkerOptions.workerSrc = `//cdnjs.cloudflare.com/ajax/libs/pdf.js/${pdfjs.version}/pdf.worker.min.js`;\n\n\nfunction MachineLearning() {\n\n    const defaultLayoutPluginInstance = defaultLayoutPlugin();\n\n    return (\n        <div>\n            <div style={{textIndent: '50px'}} className={'mt-5'}>\n                White Paper - \"<b>Tackling Climate Change with Machine Learning</b>\" - source:\n                <a href=\"https://www.climatechange.ai/\" target=\"_blank\"> https://www.climatechange.ai </a>\n            </div>\n            <br/>\n\n            <div className={'mb-5 ml-5 mr-5'}\n                 style={{\n                     height: '100%',\n                 }}\n            >\n                <div style={{\n                    border: '1px solid rgba(0, 0, 0, 0.3)',\n                    height: '750px',\n                }}>\n                    <Viewer//https://react-pdf-viewer.dev/docs/basic-usage\n                        fileUrl={pdf}\n                        plugins={[\n                            defaultLayoutPluginInstance,\n                        ]}\n                    />\n                </div>\n            </div>\n        </div>\n    )\n}\n\nexport default MachineLearning;","/Users/roland/repos/powerhypergithubpages/src/components/Footer.js",["97","98","99","100","101","102","103","104","105","106","107"],"import React from \"react\";\nimport './Footer.css';\nimport InstagramIcon from '../images/instagram_icon.png';\nimport TwitterIcon from '../images/twitter_icon.png';\n\nfunction Footer() {\n    return (\n        <footer id={\"footerMain\"}>\n            <div className=\"container text-center text-md-left\">\n                <div className=\"row text-center text-md-left mt-3 pb-3\">\n                    <div className=\"col-md-3 col-lg-3 col-xl-3 mx-auto mt-3\">\n                        <p>\n                            <a className=\"mb-4 font-weight-bold WhiteFont\">About</a>\n                        </p>\n                        <p className={'WhiteFont'}> PowerHyper shares ideas and studies in helping with the transition\n                            to renewable energy. It is a platform which aims to give the readers useful summaries,\n                            contacts and further study points.\n                        </p>\n                    </div>\n                    <div className=\"col-md-3 col-lg-2 col-xl-2 mx-auto mt-3\">\n                        <h6 className=\"mb-4 font-weight-bold WhiteFont\">Useful links</h6>\n                        <p>\n                            <a href=\"\" className=\"customHref WhiteFont\">Your Account</a>\n                        </p>\n                        <p>\n                            <a href=\"\" className=\"customHref WhiteFont\">Help</a>\n                        </p>\n                    </div>\n                    <div className=\"col-md-4 col-lg-3 col-xl-3 mx-auto mt-3\">\n                        <h6 className=\"mb-4 font-weight-bold WhiteFont\">Contact</h6>\n                        <p className={'WhiteFont'}>\n                            <i className=\"fas fa-envelope mr-3\"></i>✉ info@powerhyper.org</p>\n                        <p/>\n                    </div>\n                </div>\n                <div className=\"text-center\">\n                    <a href=\"https://www.instagram.com/_powerhyper_/\" target=\"_blank\"><img\n                        src={InstagramIcon} height={32} width={32}/></a>\n                    <a href=\"https://twitter.com/PowerHyper2021\" target=\"_blank\"><img\n                        src={TwitterIcon} height={28} width={50}/></a>\n                </div>\n                <hr className={'WhiteBorder'}/>\n                <div className=\"row d-flex align-items-center\">\n                    <div className=\"col-md-7 col-lg-8\">\n                        <p className=\"text-center text-md-left WhiteFont\">&nbsp;&nbsp;&nbsp;{(new Date().getFullYear())}:\n                            <strong> Power Hyper</strong>\n                        </p>\n                    </div>\n                    <div className=\"col-md-5 col-lg-4 ml-lg-0\">\n                        <div className=\"text-center text-md-right\">\n                            <ul className=\"list-unstyled list-inline\">\n                                <li className=\"list-inline-item\">\n                                    <a className=\"btn-floating btn-sm rgba-white-slight mx-1\">\n                                        <i className=\"fab fa-facebook-f\"></i>\n                                    </a>\n                                </li>\n                                <li className=\"list-inline-item\">\n                                    <a className=\"btn-floating btn-sm rgba-white-slight mx-1\">\n                                        <i className=\"fab fa-twitter\"></i>\n                                    </a>\n                                </li>\n                                <li className=\"list-inline-item\">\n                                    <a className=\"btn-floating btn-sm rgba-white-slight mx-1\">\n                                        <i className=\"fab fa-google-plus-g\"></i>\n                                    </a>\n                                </li>\n                                <li className=\"list-inline-item\">\n                                    <a className=\"btn-floating btn-sm rgba-white-slight mx-1\">\n                                        <i className=\"fab fa-linkedin-in\"></i>\n                                    </a>\n                                </li>\n                            </ul>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div align=\"center\">\n                <a href=\"#/copyrightDisclaimer\" className=\"customHref WhiteFont\">Copyright Disclaimer</a>\n            </div>\n            <br/>\n        </footer>\n\n    )\n}\n\nexport default Footer;\n","/Users/roland/repos/powerhypergithubpages/src/components/FundingRenewableEnergy.js",["108","109","110"],"import * as React from \"react\";\n\nexport class FundingRenewableEnergy extends React.Component {\n    render() {\n        return (\n            <div className=\"my-5 ml-custom mr-custom\">\n                <h3>Funding Renewable Energy</h3>\n                <br/>\n                <h5>Government and Policy</h5>\n                <p>Stable policies play the key role of attracting investments. Unstable policies\n                    with frequent changes are undesired.<br/>\n                </p>\n                <br/>\n                <h5>Green Banks</h5>\n                <p>Entities that will act as intermediaries in handling financing. They bring expertise and specialise\n                    in the sector,\n                    providing confidence to investors.\n                </p>\n                <br/>\n                <h5>Private Investments</h5>\n                <p>Most of the funding in renewable energy comes from the private sector. Individuals and companies\n                    are increasingly incorporating environmentally friendly features in their missions (i.e.\n                    Google's <a href=\"https://sustainability.google/projects/announcement-100/\"\n                                target=\"_blank\">commitment</a> to running their operations on 100% renewable\n                    energy).<br/>\n                </p>\n                <br/>\n                <h5><a> Crowdfunding\n                    Platforms </a></\n                    h5>\n                <p> Crowdfunding\n                    has\n                    two\n                    main\n                    advantages:</p>\n                <ul>\n                    <li type=\"i\"> Supporting\n                        renewable\n                        energy\n                        project\n                        developers\n                        with access to\n                        financing\n                    </li>\n                    <li type=\"i\">Making investments accessible to the part of the public who wish to support\n                        projects\n                        with small investments\n                    </li>\n                </ul>\n                <p>Strong support for the renewable energy crowdfunding is shown by the <a\n                    href=\"http://www.crowdfundres.eu/index.html@p=4.html\"\n                    target=\"_blank\">CROWDFUNDRES</a> project,\n                    with funding from the European Union Horizon 2020 research and innovation programme.</p>\n            </div>\n        )\n    }\n}","/Users/roland/repos/powerhypergithubpages/src/components/Startups.js",["111","112"],"import Button from \"react-bootstrap/Button\";\nimport React from \"react\";\nimport Card from \"react-bootstrap/Card\";\nimport GravitricityConcept from '../images/gravitricityConcept.png';\nimport GravitricityLogo from '../images/GravitricityLogo.png';\n\n\nfunction Startups() {\n    return (\n        <div className={'ml-5 mt-5 mr-5 mb-5'}>\n            <Card className=\"text-center\" style={{width: '25rem'}}>\n                <Card.Img variant=\"top\" width=\"200\" src={GravitricityLogo}/>\n                <Card.Body>\n                    <Card.Title>Gravitricity</Card.Title>\n                    <Card.Text>\n                        Gravity Energy Storage\n                    </Card.Text>\n                    <img src={GravitricityConcept} className=\"imgthumbnail align-self-center\" height=\"200\"\n                         width=\"300\" alt=\"Responsive image\"/>\n                    <br/>\n                    <br/>\n                    <p>Image source:&nbsp;\n                        <a href=\"http://euanmearns.com/short-term-energy-storage-with-gravitricity-iron-versus-ion/\"\n                           target=\"_blank\">http://euanmearns.com/short-term-energy-storage-with-gravitricity-iron-versus-ion/</a>\n                    </p>\n                    <br/>\n                    <Button href=\"https://gravitricity.com/\" target=\"_blank\"\n                            variant=\"primary\">https://gravitricity.com/</Button>\n                </Card.Body>\n            </Card>\n            <br/>\n            <Card className=\"text-center\" style={{width: '25rem'}}>\n                <Card.Body>\n                    <Card.Title>https://solarcoin.org/</Card.Title>\n                    <Card.Text>\n                    </Card.Text>\n                </Card.Body>\n                <Card.Body>\n                    <Card.Title>https://aetherdiamonds.com/</Card.Title>\n                    <Card.Text>\n                    </Card.Text>\n                </Card.Body>\n            </Card>\n        </div>\n    )\n}\n\nexport default Startups;","/Users/roland/repos/powerhypergithubpages/src/components/Home.js",["113","114","115","116","117","118","119","120","121","122","123","124"],"import * as React from \"react\";\nimport './Common.css';\nimport InvestmentsImage from '../images/investments.png';\nimport WindImage from '../images/wind.jpg';\nimport SolarImage from '../images/solar.jpg';\nimport Carousel from 'react-bootstrap/Carousel'\nimport CO2Levels from '../images/CO2_history.jpg'\nimport GHG from '../images/MainGreenhouseGasesSBI.jpg'\nimport './Home.css';\nimport FadeIn from 'react-fade-in';\nimport Iframe from \"react-iframe\";\nimport BuiltByTomorrow from \"../images/built-by-tomorrow.svg\";\n\n\nexport class Home extends React.Component {\n    //todo: video to show changes in powersources over time, like the ones on instagram where most used jumps to top\n    render() {\n        return (\n            <div className=\"my-5 ml-5 mr-5 home\">\n                <br/>\n                <FadeIn>\n                    <div>\n                        <p>PowerHyper shares ideas and findings in the transition to\n                            renewable energy.\n                            <br/>\n                        </p>\n                    </div>\n                    <div style={{textIndent: '50px'}}>\n                        A platform which gives the readers useful summaries,\n                        contacts and further study points.\n                    </div>\n                </FadeIn>\n                <br/>\n\n                <br/>\n                <div className={\"text-center\"}>\n                    The motivation behind PowerHyper - Lowering the greenhouse gases to the levels they\n                    were a few centuries ago ↓↓↓<br/>\n                    Trackers provided by <a\n                    href=\"https://www.2degreesinstitute.org/\"\n                    target=\"_blank\">2° Institute</a>\n                </div>\n                <br/>\n                <div id=\"greenhouseGasesWidgets\" className={\"text-center\"}>\n                    <Iframe style=\"margin-right:10px;\" url=\"https://www.co2levels.org/\"\n                            width=\"350px\"\n                            height=\"450px\"\n                            id=\"myId\"\n                            className=\"myClassname\"\n                            display=\"initial\"\n                            position=\"relative\"/>\n                    &nbsp;&nbsp;&nbsp;\n                    <Iframe url=\"https://www.methanelevels.org/\"\n                            width=\"350px\"\n                            height=\"450px\"\n                            id=\"myId\"\n                            className=\"myClassname\"\n                            display=\"initial\"\n                            position=\"relative\"/>\n                    &nbsp;&nbsp;&nbsp;\n                    <Iframe url=\"https://www.n2olevels.org/\"\n                            width=\"350px\"\n                            height=\"450px\"\n                            id=\"myId\"\n                            className=\"myClassname\"\n                            display=\"initial\"\n                            position=\"relative\"/>\n                </div>\n                <br/>\n                <div className=\"world-energy-mix\">\n                    <Iframe url=\"https://ourworldindata.org/grapher/electricity-prod-source-stacked\"\n                            width=\"80%\"\n                            height=\"450px\"\n                            id=\"worldEnergyMix\"\n                            display=\"initial\"\n                            position=\"center\"/>\n                </div>\n                <div className={'mt-5 mb-5'} style={{justifyContent:'center', textAlign:'center'}}>\n                    <p>A great tool built by <a href={\"https://www.tmrow.com/\"} target={\"_blank\"}>Tomorrow</a> for real time tracking of power generation globally.</p>\n                    <br/>\n                    <img src={BuiltByTomorrow} className=\"imgthumbnail align-self-center\"\n                         width=\"200\" alt=\"Responsive image\"/>\n                    <br/>\n                <br/>\n                    <Iframe url=\"https://www.electricitymap.org/map\"\n                            width=\"450px\"\n                            height=\"450px\"\n                            id=\"myId\"\n                            className=\"myClassname\"\n                            display=\"initial\"\n                            position=\"relative\"/>\n                </div>\n                Which <a\n                href=\"https://www.youtube.com/watch?v=sTvqIijqvTg\"\n                target=\"_blank\">greenhouse gases</a> cause most damage? (i.e. which gas captures most&nbsp;<a\n                href=\"https://www.livescience.com/50260-infrared-radiation.html\"\n                target=\"_blank\">infrared radiation</a>\n                , heating up the atmosphere?)\n                <br/>\n                <br/>\n                Short answer, in 2021, the famous carbon dioxide.\n                <br/>\n                <br/>\n                Nitrous oxide has a Global Warming Potential (GWP) of 310 relative to carbon-dioxide, meaning that for\n                the same amount,\n                it can contribute to global warming 310 times more than carbon dioxide.\n                <br/>\n                <br/>\n                However, the concentration of carbon dioxide in the atmosphere is much greater than\n                the other greenhouse gases, making carbon dioxide the greatest contributor to global warming in 2021.\n                <br/>\n                <br/>\n                <div className={\"text-center\"}>\n                    <img\n                        className=\"imgthumbnail\"\n                        width=\"70%\" alt=\"Responsive image\"\n                        src={GHG}\n                    />\n                </div>\n                <div className={\"text-center\"}>\n                    Image Source: <a\n                    href=\"http://www.global-greenhouse-warming.com/global-warming-potential.html\"\n                    target=\"_blank\">http://www.global-greenhouse-warming.com/global-warming-potential.html</a>\n                </div>\n                <br/>\n                <div className={\"text-center\"}> Light introduction to Global Warming Potential (GWP)</div>\n                <br/>\n                <div className={'iframe-container'}>\n                    <iframe width=\"80%\" src=\"https://www.youtube.com/embed/niotf0oHvQY\"\n                            title=\"YouTube video player\" frameBorder=\"0\"\n                            allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\n                            allowFullScreen></iframe>\n                </div>\n                <br/>\n                <br/>\n                <Carousel className={'carousel'}>\n                    <Carousel.Item>\n                        <img\n                            className=\"d-block h-100 w-100\"\n                            src={CO2Levels}\n                        />\n                    </Carousel.Item>\n                    <Carousel.Item>\n                        <img\n                            className=\"d-block h-100 w-100\"\n                            src={InvestmentsImage}\n                        />\n                    </Carousel.Item>\n                    <Carousel.Item>\n                        <img\n                            className=\"d-block h-100 w-100\"\n                            src={WindImage}\n                        />\n                    </Carousel.Item>\n                    <Carousel.Item>\n                        <img\n                            className=\"d-block h-100 w-100\"\n                            src={SolarImage}\n                        />\n                    </Carousel.Item>\n                </Carousel>\n            </div>\n        )\n    }\n}","/Users/roland/repos/powerhypergithubpages/src/components/CommunityEnergy.js",["125"],"import * as React from \"react\";\n\nexport class CommunityEnergy extends React.Component {\n    render() {\n        return (\n            <div className=\"my-5 ml-custom mr-custom\">\n                <h3>Community Energy</h3>\n                <br/>\n                <p>Community energy refers to the delivery of community-led renewable energy, energy demand reduction\n                    and energy supply projects, whether wholly owned and/or controlled by communities or through a\n                    partnership with commercial or public sector partners.</p>\n                <p>(\n                    <a\n                        href=\"https://communityenergyengland.org/\" target=\"_blank\">Community\n                        Energy England</a>\n                    )\n                    <br/>\n                </p>\n            </div>\n        )\n    }\n}","/Users/roland/repos/powerhypergithubpages/src/components/EnergyMarkets.js",["126"],"import * as React from \"react\";\nimport YouTube from \"react-youtube\";\n\nexport class EnergyMarkets extends React.Component {\n    render() {\n        return (\n            <div className=\"my-5 ml-custom mr-custom\">\n                <h3>Energy Markets</h3>\n                <br/>\n                <h5>Increasing complexity</h5>\n                <p>The grid is become more interconnected and complicated. Utilities do not just generate power for\n                    their own customers, but buy and sell power in a market. With a greater use of renewables, such as\n                    solar and wind, the energy markets become even more complex.</p>\n            </div>\n        )\n    }\n}","/Users/roland/repos/powerhypergithubpages/src/components/SustainableInvesting.js",["127"],"import * as React from \"react\";\nimport YouTube from \"react-youtube\";\n\nexport class SustainableInvesting extends React.Component {\n    render() {\n        return (\n            <div className=\"my-5 ml-custom mr-custom\">\n                <table>\n                    <tr>\n                        <th>ESG (Environmental, Social, Governance)</th>\n                        <th>SRI (Socially Responsible Investing)</th>\n                        <th>Impact Investing</th>\n                    </tr>\n                    <tr>\n                        <td></td>\n                        <td>SRI uses ESG factors to apply negative or positive screens on the investment universe.</td>\n                        <td></td>\n                    </tr>\n                    <tr>\n                        <td></td>\n                        <td></td>\n                        <td></td>\n                    </tr>\n                </table>\n                <h5>Green & Ethical Savings Accounts</h5>\n                <p>Cumulatively, the population can offer great support to the companies and projects they support\n                    by simply choosing where to keep savings. The people should investigate what their money in\n                    savings accounts and pensions are used for. Examples of sustainability / ESG focused companies:<br/>\n                </p>\n                <div style={{textAlign: 'center'}} width=\"80%\">\n                    <YouTube videoId=\"yQj6MSsTulg\">\n                    </YouTube>\n                </div>\n                <br/>\n                <h5>Green / ESG Savings Accounts</h5>\n                When choosing new savings accounts or investments, be cautious not to fall in the trap of&nbsp;\n                <a href=\"https://www.investopedia.com/terms/g/greenwashing.asp\"\n                   target=\"_blank\">greenwashing</a>. Don't rush into an investment and do the extra research to confirm\n                the\n                company/bank/pension/investment does what it claims.\n                <br/>\n                <h5>Company bonds</h5>\n                <h5>Project bonds</h5>\n                <h5>Shares</h5>\n                <h5>Active ownership</h5>\n                <p>Actively exercising your rights as a shareholder. The two main ways to do this are voting at shareholder meetings and engaging with the companies you are a shareholder in.</p>\n                <h5>Clean Energy Funds</h5>\n\n                <br/>\n            </div>\n        )\n    }\n}","/Users/roland/repos/powerhypergithubpages/src/components/EnergyAttributeCertificates.js",["128","129"],"import * as React from \"react\";\nimport EACs from '../images/ECOHZ-EAC-Map.jpg';\n\nexport class EnergyAttributeCertificates extends React.Component {\n    render() {\n        return (\n            <div className=\"my-5 ml-custom mr-custom\">\n                <h3>Energy Attribute Certificates</h3>\n                <br/>\n                <p>An EAC verifies that one megawatt hour <a\n                    href=\"https://www.cleanenergyauthority.com/solar-energy-resources/what-is-a-megawatt-and-a-megawatt-hour\"\n                    target=\"_blank\">\n                    (MWh)</a> of electricity was generated and fed into the grid from an eligible\n                    renewable source and it is strictly accounted for to avoid being claimed by another consumer. When\n                    purchased, they\n                    are cancelled in the registry in order to ensure they are sold only once.\n\n                    Renewable generators can sell EACs together with the electricity (bundled), or separately to the\n                    electricity\n                    (unbundled). Both methods are valid ways to track and claim renewable electricity sourcing.</p>\n                <img src={EACs} className=\"imgthumbnail align-self-center\" height=\"400\"\n                     width=\"700\" alt=\"Responsive image\"/>\n                <br/>\n                <a className=\"text-right\"\n                   href=\"https://www.ecohz.com/renewable-energy-solutions/energy-attribute-certificates/\">Source:\n                    ECOHZ</a>\n                <br/>\n                <br/>\n                <p>The Energy Attribute Certificates used in Europe are called Guarantees of Origin as defined\n                    in the European\n                    Energy Directive 2009.\n                </p>\n                <p>Trading Energy Attribute Certificates is currently difficult due to inconsistencies across\n                    different markets and\n                    high brokerage and administrative fees. Blockchain applications are rapid in development and\n                    can provide more\n                    transparency and access to trading renewable energy credits.\n                </p>\n            </div>\n        )\n    }\n}","/Users/roland/repos/powerhypergithubpages/src/components/CopyrightDisclaimer.js",[],"/Users/roland/repos/powerhypergithubpages/src/components/PowerPurchaseAgreements.js",[],"/Users/roland/repos/powerhypergithubpages/src/components/Timeline/Timeline.js",["130","131"],"import * as React from \"react\";\nimport {VerticalTimeline, VerticalTimelineElement} from 'react-vertical-timeline-component';\nimport 'react-vertical-timeline-component/style.min.css';\n\n\nexport class Timeline extends React.Component {\n    render() {\n        return (//add COP26 deal and the document\n            <VerticalTimeline bodyAttributes={{style: 'background-color : #FFF'}}>\n                <style>{'body { background-color: #89dfff; }'}</style>\n                <VerticalTimelineElement\n                    className=\"vertical-timeline-element--work\"\n                    date=\"2021\"\n                    iconStyle={{background: 'rgb(186, 255, 59)', color: '#d51111 '}}\n                >\n                    <h3 className=\"vertical-timeline-element-title\">Earthshot Prize <a\n                        href=\"https://earthshotprize.org/\"\n                        target=\"_blank\">https://earthshotprize.org/</a></h3>\n                    <p className=\"vertical-timeline-element-subtitle\">The Earthshot Prize is the most prestigious global\n                        environment prize in history, designed to incentivise change and help repair our planet over the\n                        next ten years.\n                        The Prize aims to turn the current pessimism surrounding environmental issues into optimism, by\n                        highlighting the ability of human ingenuity to bring about change, and inspiring collective\n                        action.</p>\n                </VerticalTimelineElement>\n                <VerticalTimelineElement\n                    className=\"vertical-timeline-element--work\"\n                    date=\"June 2019\"\n                    iconStyle={{background: 'rgb(186, 255, 59)', color: '#d51111 '}}\n                    //icon={<WorkIcon />}\n                >\n                    <h3 className=\"vertical-timeline-element-title\">Nitrogen Oxide concentration <a\n                        href=\"https://www.theguardian.com/environment/2020/mar/01/dramatic-fall-in-china-pollution-levels-partly-related-to-coronavirus\"\n                        target=\"_blank\">decrease</a> during Corona virus</h3>\n                </VerticalTimelineElement>\n                <VerticalTimelineElement\n                    className=\"vertical-timeline-element--work\"\n                    date=\"June 2019\"\n                    iconStyle={{background: 'rgb(186, 255, 59)', color: '#d51111 '}}\n                    //icon={<WorkIcon />}\n                >\n                    <h3 className=\"vertical-timeline-element-title\">Australian fires early signs</h3>\n                </VerticalTimelineElement>\n                <VerticalTimelineElement\n                    className=\"vertical-timeline-element--education\"\n                    date=\"4th November 2016\"\n                    iconStyle={{background: 'rgb(186, 255, 59)', color: '#fff'}}\n                    //icon={<SchoolIcon />}\n                >\n                    <h3 className=\"vertical-timeline-element-title\">Paris Agreement becomes effective</h3>\n                    <p className=\"vertical-timeline-element-subtitle\">The agreement within the United Nations\n                        Framework Convention on Climate Change, dealing with greenhouse-gas-emissions mitigation and\n                        adaptation</p>\n                </VerticalTimelineElement>\n                <VerticalTimelineElement\n                    className=\"vertical-timeline-element--education\"\n                    date=\"1880s\"\n                    iconStyle={{background: 'rgb(186, 255, 59)', color: '#fff'}}\n                    // icon={CoalMiningIcon()}\n                >\n                    <h3 className=\"vertical-timeline-element-title\">Coal Mining Growing</h3>\n                </VerticalTimelineElement>\n            </VerticalTimeline>\n        )\n    }\n}","/Users/roland/repos/powerhypergithubpages/src/components/CircularEconomy.js",[],{"ruleId":"132","severity":1,"message":"133","line":2,"column":9,"nodeType":"134","messageId":"135","endLine":2,"endColumn":16},{"ruleId":"136","severity":1,"message":"137","line":5,"column":5,"nodeType":"138","messageId":"139","endLine":56,"endColumn":6},{"ruleId":"140","severity":1,"message":"141","line":8,"column":17,"nodeType":"142","endLine":8,"endColumn":54},{"ruleId":"140","severity":1,"message":"141","line":27,"column":29,"nodeType":"142","endLine":28,"endColumn":98},{"ruleId":"140","severity":1,"message":"141","line":40,"column":29,"nodeType":"142","endLine":41,"endColumn":98},{"ruleId":"143","severity":1,"message":"144","line":35,"column":21,"nodeType":"142","endLine":36,"endColumn":62},{"ruleId":"145","severity":1,"message":"146","line":38,"column":21,"nodeType":"142","messageId":"147","endLine":38,"endColumn":78,"fix":"148"},{"ruleId":"145","severity":1,"message":"146","line":11,"column":42,"nodeType":"142","messageId":"147","endLine":11,"endColumn":95,"fix":"149"},{"ruleId":"143","severity":1,"message":"144","line":13,"column":17,"nodeType":"142","endLine":14,"endColumn":58},{"ruleId":"145","severity":1,"message":"146","line":20,"column":17,"nodeType":"142","messageId":"147","endLine":20,"endColumn":73,"fix":"150"},{"ruleId":"140","severity":1,"message":"151","line":13,"column":29,"nodeType":"142","endLine":13,"endColumn":76},{"ruleId":"140","severity":1,"message":"141","line":23,"column":29,"nodeType":"142","endLine":23,"endColumn":73},{"ruleId":"140","severity":1,"message":"141","line":26,"column":29,"nodeType":"142","endLine":26,"endColumn":73},{"ruleId":"145","severity":1,"message":"146","line":37,"column":21,"nodeType":"142","messageId":"147","endLine":37,"endColumn":87,"fix":"152"},{"ruleId":"153","severity":1,"message":"154","line":37,"column":87,"nodeType":"142","endLine":38,"endColumn":69},{"ruleId":"145","severity":1,"message":"146","line":39,"column":21,"nodeType":"142","messageId":"147","endLine":39,"endColumn":82,"fix":"155"},{"ruleId":"153","severity":1,"message":"154","line":39,"column":82,"nodeType":"142","endLine":40,"endColumn":67},{"ruleId":"140","severity":1,"message":"151","line":53,"column":37,"nodeType":"142","endLine":53,"endColumn":95},{"ruleId":"140","severity":1,"message":"151","line":58,"column":37,"nodeType":"142","endLine":58,"endColumn":95},{"ruleId":"140","severity":1,"message":"151","line":63,"column":37,"nodeType":"142","endLine":63,"endColumn":95},{"ruleId":"140","severity":1,"message":"151","line":68,"column":37,"nodeType":"142","endLine":68,"endColumn":95},{"ruleId":"145","severity":1,"message":"146","line":23,"column":30,"nodeType":"142","messageId":"147","endLine":24,"endColumn":49,"fix":"156"},{"ruleId":"140","severity":1,"message":"151","line":28,"column":21,"nodeType":"142","endLine":28,"endColumn":24},{"ruleId":"145","severity":1,"message":"146","line":50,"column":89,"nodeType":"142","messageId":"147","endLine":52,"endColumn":37,"fix":"157"},{"ruleId":"143","severity":1,"message":"144","line":18,"column":21,"nodeType":"142","endLine":19,"endColumn":62},{"ruleId":"145","severity":1,"message":"146","line":23,"column":25,"nodeType":"142","messageId":"147","endLine":24,"endColumn":44,"fix":"158"},{"ruleId":"145","severity":1,"message":"146","line":39,"column":42,"nodeType":"142","messageId":"147","endLine":41,"endColumn":37,"fix":"159"},{"ruleId":"160","severity":1,"message":"161","line":45,"column":29,"nodeType":"162","messageId":"163","endLine":45,"endColumn":55},{"ruleId":"145","severity":1,"message":"146","line":79,"column":46,"nodeType":"142","messageId":"147","endLine":79,"endColumn":99,"fix":"164"},{"ruleId":"143","severity":1,"message":"144","line":81,"column":21,"nodeType":"142","endLine":82,"endColumn":62},{"ruleId":"145","severity":1,"message":"146","line":93,"column":23,"nodeType":"142","messageId":"147","endLine":95,"endColumn":33,"fix":"165"},{"ruleId":"145","severity":1,"message":"146","line":95,"column":108,"nodeType":"142","messageId":"147","endLine":97,"endColumn":33,"fix":"166"},{"ruleId":"143","severity":1,"message":"144","line":114,"column":21,"nodeType":"142","endLine":118,"endColumn":23},{"ruleId":"145","severity":1,"message":"146","line":121,"column":35,"nodeType":"142","messageId":"147","endLine":123,"endColumn":37,"fix":"167"},{"ruleId":"153","severity":1,"message":"154","line":138,"column":25,"nodeType":"142","endLine":141,"endColumn":27},{"ruleId":"153","severity":1,"message":"154","line":144,"column":25,"nodeType":"142","endLine":147,"endColumn":27},{"ruleId":"153","severity":1,"message":"154","line":150,"column":25,"nodeType":"142","endLine":153,"endColumn":27},{"ruleId":"153","severity":1,"message":"154","line":156,"column":25,"nodeType":"142","endLine":159,"endColumn":27},{"ruleId":"145","severity":1,"message":"146","line":13,"column":21,"nodeType":"142","messageId":"147","endLine":14,"endColumn":84,"fix":"168"},{"ruleId":"132","severity":1,"message":"169","line":2,"column":8,"nodeType":"134","messageId":"135","endLine":2,"endColumn":15},{"ruleId":"145","severity":1,"message":"146","line":37,"column":17,"nodeType":"142","messageId":"147","endLine":38,"endColumn":36,"fix":"170"},{"ruleId":"145","severity":1,"message":"146","line":10,"column":59,"nodeType":"142","messageId":"147","endLine":12,"endColumn":37,"fix":"171"},{"ruleId":"143","severity":1,"message":"144","line":21,"column":17,"nodeType":"142","endLine":22,"endColumn":58},{"ruleId":"145","severity":1,"message":"146","line":16,"column":85,"nodeType":"142","messageId":"147","endLine":18,"endColumn":41,"fix":"172"},{"ruleId":"145","severity":1,"message":"146","line":32,"column":98,"nodeType":"142","messageId":"147","endLine":34,"endColumn":41,"fix":"173"},"no-unused-vars","'NavLink' is defined but never used.","Identifier","unusedVar","no-lone-blocks","Nested block is redundant.","BlockStatement","redundantNestedBlock","jsx-a11y/anchor-is-valid","The href attribute requires a valid value to be accessible. Provide a valid, navigable address as the href value. If you cannot provide a valid href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/jsx-eslint/eslint-plugin-jsx-a11y/blob/HEAD/docs/rules/anchor-is-valid.md","JSXOpeningElement","jsx-a11y/img-redundant-alt","Redundant alt attribute. Screen-readers already announce `img` tags as an image. You don’t need to use the words `image`, `photo,` or `picture` (or any specified custom words) in the alt prop.","react/jsx-no-target-blank","Using target=\"_blank\" without rel=\"noreferrer\" (which implies rel=\"noopener\") is a security risk in older browsers: see https://mathiasbynens.github.io/rel-noopener/#recommendations","noTargetBlankWithoutNoreferrer",{"range":"174","text":"175"},{"range":"176","text":"175"},{"range":"177","text":"175"},"The href attribute is required for an anchor to be keyboard accessible. Provide a valid, navigable address as the href value. If you cannot provide an href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/jsx-eslint/eslint-plugin-jsx-a11y/blob/HEAD/docs/rules/anchor-is-valid.md",{"range":"178","text":"175"},"jsx-a11y/alt-text","img elements must have an alt prop, either with meaningful text, or an empty string for decorative images.",{"range":"179","text":"175"},{"range":"180","text":"175"},{"range":"181","text":"175"},{"range":"182","text":"175"},{"range":"183","text":"175"},"react/style-prop-object","Style prop value must be an object","JSXAttribute","stylePropNotObject",{"range":"184","text":"175"},{"range":"185","text":"175"},{"range":"186","text":"175"},{"range":"187","text":"175"},{"range":"188","text":"175"},"'YouTube' is defined but never used.",{"range":"189","text":"175"},{"range":"190","text":"175"},{"range":"191","text":"175"},{"range":"192","text":"175"},[2112,2112]," rel=\"noreferrer\"",[405,405],[869,869],[1940,1940],[2099,2099],[1206,1206],[2319,2319],[1096,1096],[1686,1686],[3572,3572],[4355,4355],[4546,4546],[5795,5795],[677,677],[1801,1801],[534,534],[877,877],[2091,2091]]